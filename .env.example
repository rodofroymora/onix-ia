# Auth.js / NextAuth
AUTH_SECRET=cambia-este-secreto-demo
# NEXTAUTH_URL=http://localhost:3000

# Firmas del portal respondente (HMAC)
RESPONDENT_TOKEN_SECRET=cambia-este-secreto-respondente

# Contraseña compartida de usuarios demo (no commitear el valor real)
DEMO_PASSWORD=cambia-esta-contrasena-demo

# Base de datos
# Por defecto: PGlite en .data/govern.pg (ruta absoluta vía apps/web)
# PGLITE_DATA_DIR=/ruta/absoluta/.data/govern.pg
# DATABASE_URL=file:/ruta/absoluta/.data/govern.pg
# Producción: DATABASE_URL=postgres://user:pass@host:5432/onix

# Feature flags
FEATURE_V1_5=false
FEATURE_ASSISTANT=false
