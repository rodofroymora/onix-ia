# Auth.js / NextAuth — define valores reales solo en .env.local (no commitear)
AUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# Firmas del portal respondente (HMAC)
RESPONDENT_TOKEN_SECRET=

# Contraseña compartida de usuarios demo
DEMO_PASSWORD=

# Base de datos
# Por defecto: PGlite en .data/govern.pg
# PGLITE_DATA_DIR=/ruta/absoluta/.data/govern.pg
# DATABASE_URL=file:/ruta/absoluta/.data/govern.pg

# Feature flags
FEATURE_V1_5=false
FEATURE_ASSISTANT=false
